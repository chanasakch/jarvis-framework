{
  "name": "jarvis-site",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "tsx scripts/generate-content.ts && next dev",
    "generate": "tsx scripts/generate-content.ts",
    "search-index": "tsx scripts/generate-search-index.ts",
    "check:i18n": "tsx scripts/check-i18n-parity.ts",
    "check:routes": "tsx scripts/check-route-parity.ts",
    "check:links": "tsx scripts/check-links.ts",
    "build": "npm run generate && npm run search-index && npm run check:i18n && npm run check:routes && next build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "next": "16.3.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "next-themes": "0.4.6",
    "cmdk": "1.1.1",
    "sonner": "2.0.8",
    "lucide-react": "1.47.0",
    "next-mdx-remote": "6.0.0",
    "gray-matter": "4.0.3",
    "remark-gfm": "4.0.1",
    "rehype-pretty-code": "0.14.5",
    "shiki": "4.4.3",
    "zod": "4.6.5",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "tailwind-merge": "3.7.0",
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-tooltip": "1.2.16",
    "@radix-ui/react-dropdown-menu": "2.1.24",
    "@radix-ui/react-tabs": "1.1.21",
    "@radix-ui/react-popover": "1.1.23",
    "@radix-ui/react-separator": "1.1.15",
    "@radix-ui/react-slot": "1.3.3"
  },
  "devDependencies": {
    "typescript": "6.0.3",
    "tailwindcss": "4.3.3",
    "@tailwindcss/postcss": "4.3.3",
    "tsx": "4.23.13",
    "vitest": "5.0.1",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.5",
    "@playwright/test": "1.63.0",
    "@axe-core/playwright": "4.13.0",
    "@types/node": "22.20.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "js-yaml": "4.3.2",
    "@types/js-yaml": "4.0.9",
    "tw-animate-css": "1.4.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "unrs-resolver@1.12.2": true,
    "fsevents@2.3.3": true
  }
}
